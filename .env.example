# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=enkephalin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=enkephalin
DATABASE_URL=postgres://enkephalin:change-me@db:5432/enkephalin
# The same database as the app sees it from a terminal on this machine. Used by
# the scripts (npm run export / restore / seed), which cannot resolve the
# compose hostname `db`.
DATABASE_URL_HOST=postgres://enkephalin:change-me@127.0.0.1:5432/enkephalin

# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Seeded on first boot; the invite system covers everyone after that.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

SITE_NAME=Enkephalin
