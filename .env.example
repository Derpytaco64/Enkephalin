# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=enkephalin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=enkephalin
DATABASE_URL=postgres://enkephalin:change-me@db:5432/enkephalin
# The same database as the app sees it from a terminal on this machine. Used by
# the scripts (npm run export / restore / seed), which cannot resolve the
# compose hostname `db`.
DATABASE_URL_HOST=postgres://enkephalin:change-me@127.0.0.1:5432/enkephalin

# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Any OTHER address the app is reached at, comma-separated. Needed the moment
# a reverse proxy, a Tailscale name or a second hostname is in play: better-auth
# trusts only the origin of BETTER_AUTH_URL and answers a sign-in from anywhere
# else with `Invalid origin` and a 403. Origins, not URLs -- scheme, host, port.
#   BETTER_AUTH_TRUSTED_ORIGINS=https://drugs.example.com,http://192.168.1.50:3636
BETTER_AUTH_TRUSTED_ORIGINS=

# Seeded on first boot; the invite system covers everyone after that.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

SITE_NAME=Enkephalin

# A drug created without a class gets one looked up from RxNav -- the FDA's
# Established Pharmacologic Class, the same source the library's first 236 were
# classed from. Set to `off` on a box with no route out to the internet: the
# lookup already gives up on its own and creates the drug uncategorized, but
# off means it does not wait first.
#   DRUG_CLASS_LOOKUP=off
DRUG_CLASS_LOOKUP=
